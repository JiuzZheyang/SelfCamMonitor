<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮按下时轻微悬浮抬起，松开回落 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="translationZ" android:duration="90" android:valueFrom="0dp" android:valueTo="4dp" android:valueType="floatType" />
            <objectAnimator android:propertyName="elevation" android:duration="90" android:valueFrom="2dp" android:valueTo="6dp" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_enabled="true">
        <set>
            <objectAnimator android:propertyName="translationZ" android:duration="90" android:valueFrom="4dp" android:valueTo="0dp" android:valueType="floatType" />
            <objectAnimator android:propertyName="elevation" android:duration="90" android:valueFrom="6dp" android:valueTo="2dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
